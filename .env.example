# AB Platform environment template
# Copy this file to .env for local experiments or use it as a checklist for CI/CD secrets.
# Do not commit real production secrets.

# Backend
PORT=3000
JWT_SECRET=replace-with-secure-random-value
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-temporary-admin-password
ADMIN_ROLE=owner

# PostgreSQL
POSTGRES_DB=ab_platform
POSTGRES_USER=ab_platform_user
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_URL=postgres://ab_platform_user:replace-with-secure-postgres-password@postgres:5432/ab_platform

# ClickHouse
CLICKHOUSE_DB=default
CLICKHOUSE_USER=ab_user
CLICKHOUSE_PASSWORD=replace-with-secure-clickhouse-password
CLICKHOUSE_URL=http://clickhouse:8123

# Admin UI build/runtime exposure
# For local compose this can be http://localhost:3000.
# For a real deployment use the public HTTPS backend URL, for example https://ab-api.company.local.
PUBLIC_API_URL=http://localhost:3000
BACKEND_PORT=3000
ADMIN_PORT=5173
