{
  "name": "@mathculture/ab-sdk",
  "version": "0.1.4",
  "description": "React 18+ SDK for self-hosted feature toggles, rollout, events, and A/B testing",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "keywords": [
    "ab-testing",
    "feature-toggle",
    "feature-flags",
    "react",
    "sdk",
    "rollout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Egori11a/diplom.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Egori11a/diplom/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/Egori11a/diplom/issues"
  },
  "files": [
    "build",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --environment jsdom",
    "lint": "echo \"no lint\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
