{
  "name": "@mathculture/ab-sdk",
  "version": "0.1.0",
  "description": "React 18+ SDK for self-hosted feature toggles and A/B testing",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "echo \"no lint\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
